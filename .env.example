# Relative paths resolve from the repository root. No database server or credentials needed.
DATABASE_PATH=data/finance-tracker.db
# Isolated interactive demo: python -m app.demo (do not change DATABASE_PATH).
SQLITE_BUSY_TIMEOUT_MS=5000
# Conservative learning needs distinct, consistent explicit corrections (minimum 3).
LEARNING_MIN_EXAMPLES=3
# Candidate date tolerance; matching always requires confirmation (0-14 days).
SCHEDULE_MATCH_DAYS=3
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Optional, server-side only. Leave empty for offline operation/public Brapi test symbols.
BRAPI_API_TOKEN=
# Enable only with a plan supporting includeRaw=true (Pro); adjusted history is never valued.
BRAPI_RAW_HISTORY=false
BRAPI_BATCH_SIZE=1
ALPHA_VANTAGE_API_KEY=
# Full daily history requires an eligible premium plan; default uses 100 daily observations.
ALPHA_VANTAGE_FULL_HISTORY=false
# Automatic synchronization is opt-in under Settings > Market Data; one API worker only.
MARKET_SYNC_INTERVAL_MINUTES=360
# Optional Gmail Desktop OAuth client. Backend only; leave blank for offline operation.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact browser origins permitted to control Gmail (adjust for custom local ports).
GMAIL_LOCAL_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# Conservative local matching window; fuzzy proposals always require confirmation.
RECONCILIATION_MATCH_DAYS=3
